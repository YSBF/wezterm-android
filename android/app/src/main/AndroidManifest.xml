<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The mux and its child shells run inside a foreground service so that
         a backgrounded app is not killed, taking every running command with
         it. POST_NOTIFICATIONS is required from API 33 to show the ongoing
         notification that a foreground service must have. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Long-running builds must not be suspended mid-way when the screen
         turns off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.WezTerm"
        android:hardwareAccelerated="true"
        android:enableOnBackInvokedCallback="true"
        android:extractNativeLibs="true">

        <activity
            android:name=".WezTermActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout|smallestScreenSize|locale|layoutDirection|density|uiMode|navigation"
            android:windowSoftInputMode="adjustResize"
            android:resizeableActivity="true">

            <!-- android-activity reads the library name from here rather than
                 requiring a System.loadLibrary call with a hardcoded name. -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="wezterm_gui" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".MuxService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps interactive shell sessions and their child processes running while the terminal is in the background." />
        </service>
    </application>
</manifest>
